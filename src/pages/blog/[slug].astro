---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { shouldShowDrafts } from "../../utils/drafts";
import LessonLayout from "../../layouts/LessonLayout.astro";
import H1 from "../../components/H1.astro";
import DraftBanner from "../../components/DraftBanner.astro";
import Image from "astro/components/Image.astro";

export const getStaticPaths = async () => {
    const posts = await getCollection('posts');
    let paths = posts.map(post => {
        return {
            params: {
                slug: post.slug
            },
            props: {
                post,
                isDraft: false
            }
        }
    });

    if (shouldShowDrafts()) {
        const drafts = await getCollection('drafts');
        const draftPaths = drafts.map(draft => {
            return {
                params: {
                    slug: draft.slug
                },
                props: {
                    post: draft,
                    isDraft: true
                }
            }
        });
        paths = [...paths, ...draftPaths];
    }

    return paths;
}

type Props = {
    post: CollectionEntry<"posts"> | CollectionEntry<"drafts">,
    isDraft: boolean
}

const {post, isDraft} = Astro.props;
const {Content} = await post.render();
---

<LessonLayout title={post.data.title}>
    {isDraft && <DraftBanner />}
    <div class="text-2xl font-bold ">{post.data.title} </div>
    <div class="text-xs text-midnight-green">
        <span class="pr-4">{post.data.originalDate ? `Written:  ${post.data.originalDate}` : ' '}</span>
        <span>{post.data.updated ? `Last Updated:  ${post.data.updated}` : ' '}</span>
    </div>
    <Image
        src={post.data.image}
        alt={post.data.title}
        width={1024}
        height={1024 / 1.5}
    />
    <div class="prose prose-lg overflow-visible relative mb-20">
        <Content />
    </div>
</LessonLayout>