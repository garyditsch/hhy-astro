---
import type { CollectionEntry } from "astro:content"
import { Image } from 'astro:assets';

type Props = {
    post: CollectionEntry<'posts'> | CollectionEntry<'drafts'>,
    isDraft?: boolean
};

const {post, isDraft = false} = Astro.props;
---

<article class="relative">
    <a
        href={`/blog/${post.slug}`}
        class="relative block"
    >
        {isDraft && (
            <div class="absolute top-4 right-4 z-10">
                <span class="bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold">
                    DRAFT
                </span>
            </div>
        )}
        <Image
            src={post.data.image}
            alt={post.data.title}
            width={600}
            height={600 / 1.5}
            class="rounded-2xl shadow-xl mb-4 aspect-thumbnail object-cover"
        />
    </a>

    <a
        href={`/blog/${post.slug}`}
        class="text-2xl text-zinc-900 font-semibold inline-block"
    >
        <h2 class="line-clamp-1">{post.data.title}</h2>
    </a>

    <p class="text-zinc-500 text-md line-clamp-2">
        {post.body}
    </p>
    
</article>